generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Модель пользователя
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  phone     String    @unique
  name      String
  password  String    // будет хешированным
  role      Role      @default(CLIENT)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

// Модель услуги
model Service {
  id          Int       @id @default(autoincrement())
  name        String
  description String    @db.Text
  priceFrom   Int       // в рублях
  duration    Int       // в минутах
  isActive    Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("services")
}

// Модель записи на мойку
model Booking {
  id        Int           @id @default(autoincrement())
  user      User          @relation(fields: [userId], references: [id])
  userId    Int
  service   Service       @relation(fields: [serviceId], references: [id])
  serviceId Int
  date      DateTime      @db.Date
  time      String        // формат "09:00"
  status    BookingStatus @default(PENDING)
  
  // Контактные данные (для записи без регистрации)
  name      String
  phone     String
  email     String
  
  payment   Payment?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([serviceId])
  @@index([date])
  @@map("bookings")
}

// Модель платежа
model Payment {
  id            Int           @id @default(autoincrement())
  booking       Booking       @relation(fields: [bookingId], references: [id])
  bookingId     Int           @unique
  amount        Int           // в копейках (1500 = 15.00 руб)
  status        PaymentStatus @default(PENDING)
  paymentMethod String?       // card, sbp, wallet, etc
  provider      String?       // yukassa, stripe, mock
  externalId    String?       // ID платежа в платежной системе
  paymentUrl    String?       @db.Text // URL для оплаты
  paidAt        DateTime?     // Когда оплачено
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

// Роли пользователей
enum Role {
  CLIENT
  ADMIN
}

// Статусы записи
enum BookingStatus {
  PENDING    // Ожидает подтверждения
  CONFIRMED  // Подтверждена
  COMPLETED  // Выполнена
  CANCELLED  // Отменена
}

// Статусы платежа
enum PaymentStatus {
  PENDING    // Ожидает оплаты
  PROCESSING // В процессе
  PAID       // Оплачен
  FAILED     // Ошибка оплаты
  REFUNDED   // Возврат
}
