# ============================================
# Настройки сервера
# ============================================
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ============================================
# URL API (для фронтенда)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ============================================
# База данных MySQL
# ⚠️ ВАЖНО: Замените user:password на ваши учетные данные MySQL!
# ============================================
DATABASE_URL="mysql://root:password@localhost:3306/detailing_volgograd"

# ============================================
# JWT секреты (для авторизации)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================
# Платёжные системы (заглушки)
# ============================================
# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# CloudPayments
CLOUDPAYMENTS_PUBLIC_ID=your_cloudpayments_public_id
CLOUDPAYMENTS_API_SECRET=your_cloudpayments_api_secret

# ЮKassa
YUKASSA_SHOP_ID=your_yukassa_shop_id
YUKASSA_SECRET_KEY=your_yukassa_secret_key

# ============================================
# Карты (Google Maps / Яндекс.Карты)
# ============================================
# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Яндекс.Карты API Key
YANDEX_MAPS_API_KEY=your_yandex_maps_api_key

# ============================================
# SMS и Email (заглушки для будущих интеграций)
# ============================================
# SMS провайдер (например, SMS.ru, Twilio)
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://api.sms-provider.com

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
